# Modus Federator — Environment Configuration
# Copy to .env and fill in values before deployment.

# ── Required ──────────────────────────────────────────────────────────────────
# Shared secret for JWT verification (must match orchestrator's JWT signing key)
FEDERATOR_JWT_SECRET=change-me-to-a-strong-secret

# ── Optional (sensible defaults) ──────────────────────────────────────────────
FEDERATOR_DATABASE_URL=sqlite+aiosqlite:///federator.db
FEDERATOR_ENVIRONMENT=production
FEDERATOR_DEBUG=false
FEDERATOR_PORT=8443

# JWT configuration
FEDERATOR_JWT_ISSUER=modus-orchestrator
FEDERATOR_JWT_AUDIENCE=modus-federator

# Rate limiting
FEDERATOR_RATE_LIMIT_SUBMITS_PER_HOUR=10
FEDERATOR_RATE_LIMIT_READS_PER_HOUR=60
FEDERATOR_RATE_LIMIT_BURST=5

# Aggregation
FEDERATOR_AGGREGATION_INTERVAL_MINUTES=60
FEDERATOR_MIN_CONTRIBUTORS_FOR_RESULT=3

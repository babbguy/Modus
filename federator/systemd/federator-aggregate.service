# Modus Federator — Aggregation Service
# ===========================================
# One-shot service triggered by federator-aggregate.timer.
# Runs the static publisher, writes JSON, exits.
#
# Install: sudo cp federator-aggregate.service /etc/systemd/system/

[Unit]
Description=Modus Federator Aggregation Job
After=network.target

[Service]
Type=oneshot
User=federator
Group=federator
WorkingDirectory=/opt/federator

Environment=FEDERATOR_DB_PATH=/data/federator.db
Environment=FEDERATOR_STATIC_DIR=/data/static
EnvironmentFile=-/opt/federator/.env

ExecStart=/opt/federator/venv/bin/python -m federator.core.static_publisher

# Resource limits
MemoryMax=128M
CPUQuota=50%
TimeoutStartSec=60

# Security
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/data
PrivateTmp=true

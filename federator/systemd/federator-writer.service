# Modus Federator — Write Handler Service
# =============================================
# Socket-activated: systemd holds 127.0.0.1:8444 (federator-writer.socket) and
# starts this service on the first connection, passing the listening socket as
# file descriptor 3. Once started, it keeps running.
#
# Type=exec: uvicorn never sends sd_notify, so systemd must not wait for a
# READY=1 that never comes (Type=notify) or a watchdog ping (WatchdogSec).
#
# RAM: ~40-60MB once started, 0 before the first connection.
#
# Install: ./deploy.sh --systemd (or sudo cp federator-writer.service /etc/systemd/system/)
# Logs:    journalctl -u federator-writer -f

[Unit]
Description=Modus Federator Write Handler
Requires=federator-writer.socket
After=network.target federator-writer.socket
# Stop restarting after 5 failures within 2 minutes (the unit then stays failed)
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=exec
User=federator
Group=federator
WorkingDirectory=/opt/federator
Environment=FEDERATOR_DB_PATH=/data/federator.db
# FEDERATOR_JWT_SECRET (required) comes from this file; the writer refuses to
# start without it.
EnvironmentFile=/opt/federator/.env

ExecStart=/opt/federator/venv/bin/uvicorn \
    federator.write_handler:app \
    --fd 3 \
    --workers 1 \
    --timeout-keep-alive 30 \
    --access-log \
    --log-level warning

Restart=on-failure
RestartSec=2
TimeoutStopSec=10

# Resource limits — lightweight
MemoryMax=128M
CPUQuota=50%

# Security hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/data
PrivateTmp=true

[Install]
WantedBy=multi-user.target

# =============================================================================
# Modus — Environment Configuration
# =============================================================================
# Copy to .env and fill in your values.
# All data stays on your infrastructure. Outbound calls happen only to the LLM
# providers you configure and to optional integrations you enable.
# =============================================================================

# ── Deployment Mode ─────────────────────────────────────────────────────────
# Informational marker. install.sh --org-wide sets it to org-wide and starts the
# Compose profile "org-wide"; nothing in the application reads it.
# standalone = Orchestrator only (it serves the dashboard)
# org-wide   = Orchestrator + Conductor
MODUS_MODE=standalone

# ── Database ────────────────────────────────────────────────────────────────
# SQLite is the default here. No external DB needed. Data is persisted to the
# Docker volume. Use a postgresql+asyncpg:// URL for PostgreSQL.
MODUS_DATABASE_URL=sqlite+aiosqlite:///data/modus.db

# ── Network ─────────────────────────────────────────────────────────────────
# Orchestrator port (dashboard + API served here)
MODUS_PORT=8080

# Conductor port (org-wide mode only, ignored in standalone)
MODUS_CONDUCTOR_PORT=8090

# ── Authentication ──────────────────────────────────────────────────────────
# Master API key for administrative operations (app registration, policy mgmt).
# Auto-generated during install. Regenerate with:
#   python -c "import secrets; print('mds_master_' + secrets.token_urlsafe(32))"
MODUS_MASTER_API_KEY=mds_master_CHANGE_ME

# Auth mode: jwt = bearer JWTs signed with MODUS_JWT_SECRET (set that too).
# stub = NO AUTH, development only: it is refused at startup while
# MODUS_ENVIRONMENT is not "development". Leave this as jwt unless you are doing
# throwaway local development (then also set MODUS_ENVIRONMENT=development).
MODUS_AUTH_MODE=jwt
# Required for jwt mode (a long random string, or a PEM public key for RS256):
# MODUS_JWT_SECRET=

# ── Logging ─────────────────────────────────────────────────────────────────
MODUS_LOG_LEVEL=INFO
MODUS_LOG_FORMAT=json
MODUS_ENVIRONMENT=production

# ── Nomus Integration (Optional) ────────────────────────────────────────
# Connect to a Nomus instance (https://github.com/babbguy/Nomus). Rules are
# pulled into Modus and evaluated locally; no usage data is sent to Nomus.
# MODUS_NOMUS_URL=https://nomus.yourcompany.com
# MODUS_NOMUS_API_KEY=

# ── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated origins allowed to access the API.
# Default allows the built-in dashboard.
MODUS_CORS_ORIGINS=http://localhost:8080

# ── Image Version ───────────────────────────────────────────────────────────
# Image tag used by docker-compose.prod.yml. The compose file builds from this
# checkout by default; the tag matters when you pull published images instead.
# upgrade.sh --version writes this value.
MODUS_VERSION=latest

# ── Advanced (usually no changes needed) ────────────────────────────────────
# MODUS_ENFORCEMENT_ENABLED=true
# MODUS_ENFORCEMENT_FAIL_OPEN=false
# MODUS_MAX_BATCH_SIZE=1000
# MODUS_AGGREGATE_INTERVAL_SECONDS=60
# MODUS_PRUNE_HEARTBEATS_DAYS=30
# MODUS_PLUGINS_ENABLED=true

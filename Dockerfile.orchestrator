# Modus Orchestrator — Production Dockerfile
# ====================================================
# Multi-stage build:
#   builder — install deps in isolated layer
#   runtime — minimal image with only what's needed to run

# ── Stage 1: builder ──────────────────────────────────────────────────────────
FROM python:3.12-slim@sha256:a6e34c598f2467ed0e9a8d349809fcd8b5c603269512df273a0bb1784edc11b1 AS builder

WORKDIR /build

# System deps for building Python packages with C extensions
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

# Install Python deps into isolated prefix
COPY orchestrator/requirements.txt .
RUN pip install --prefix=/install --no-cache-dir -r requirements.txt

# ── Stage 2: runtime ──────────────────────────────────────────────────────────
FROM python:3.12-slim@sha256:a6e34c598f2467ed0e9a8d349809fcd8b5c603269512df273a0bb1784edc11b1 AS runtime

# Non-root user — security hardening
RUN groupadd -r modus && useradd -r -g modus -d /app -s /sbin/nologin modus

# Runtime system deps only
RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq5 \
    curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy installed packages from builder
COPY --from=builder /install /usr/local

# Copy application code
COPY orchestrator/ ./orchestrator/
COPY migrations/ ./migrations/
COPY alembic.ini ./
COPY dashboard/ ./dashboard/

# The version the service reports, baked in at build time: publish.yml
# passes the release version (docker build --build-arg MODUS_BUILD_VERSION=1.2.0).
# Without it, the image reports the version in the source. The image tag
# (MODUS_VERSION in deploy/.env) does not change it.
ARG MODUS_BUILD_VERSION=""
LABEL org.opencontainers.image.version="${MODUS_BUILD_VERSION}"
RUN if [ -n "$MODUS_BUILD_VERSION" ]; then \
        echo "$MODUS_BUILD_VERSION" | grep -Eqx '[0-9]+\.[0-9]+\.[0-9]+([-+][0-9A-Za-z.+-]+)?' \
            || { echo "MODUS_BUILD_VERSION must be a version such as 1.2.0, not '$MODUS_BUILD_VERSION'" >&2; exit 1; }; \
        printf '%s\n' "$MODUS_BUILD_VERSION" > orchestrator/BUILD_VERSION; \
    fi

# Migration-aware entrypoint (runs alembic for Postgres, skips for SQLite)
COPY docker-entrypoint.sh /usr/local/bin/docker-entrypoint.sh
RUN chmod +x /usr/local/bin/docker-entrypoint.sh

# Set ownership
RUN mkdir -p /app/data && chown -R modus:modus /app

USER modus

# Environment defaults — override via k8s ConfigMap / Secret
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONPATH=/app

EXPOSE 8080

# Health check — liveness probe
HEALTHCHECK --interval=15s --timeout=5s --start-period=30s --retries=3 \
    CMD curl -f http://localhost:8080/health || exit 1

# Entry point
# The entrypoint applies Alembic migrations for PostgreSQL deployments, then
# exec's the CMD below. SQLite deployments skip migrations (init_db create_all).
# Note: --workers 1 is intentional. Horizontal scale is via k8s replicas.
# Multiple uvicorn workers per pod complicates graceful shutdown and health checks.
ENTRYPOINT ["/usr/local/bin/docker-entrypoint.sh"]
CMD ["uvicorn", "orchestrator.main:app", \
     "--host", "0.0.0.0", \
     "--port", "8080", \
     "--workers", "1", \
     "--loop", "auto", \
     "--no-access-log"]

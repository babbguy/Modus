# Modus — Environment Configuration
# Copyright 2026 babbguy
# SPDX-License-Identifier: Apache-2.0
#
# Copy to .env and fill in your values: cp .env.example .env
#
# All data stays in your environment. Outbound calls happen only to the LLM
# providers you configure and to optional integrations you enable.

# Local evaluation only: to try Modus on your own machine without an identity
# provider, set MODUS_ENVIRONMENT=development and MODUS_AUTH_MODE=stub below.
# Stub auth gives every request admin rights and is refused unless MODUS_ENVIRONMENT=development.

# ── Database ─────────────────────────────────────────────────────────────────
# PostgreSQL (recommended for production):
#   MODUS_DATABASE_URL=postgresql+asyncpg://user:password@host:5432/modus
# SQLite (quick start / single-server):
#   MODUS_DATABASE_URL=sqlite+aiosqlite:///modus.db
MODUS_DATABASE_URL=sqlite+aiosqlite:///modus.db

# PostgreSQL password (used by docker-compose.yml)
# WARNING: Change this to a strong, unique password before deploying to production!
POSTGRES_PASSWORD=CHANGE_ME_BEFORE_PRODUCTION

# ── Auth ──────────────────────────────────────────────────────────────────────
# jwt  = real authentication. Requests carry a bearer JWT signed with
#        MODUS_JWT_SECRET (HS256, or RS256 if the value is a PEM key) whose
#        audience matches MODUS_JWT_AUDIENCE (default "modus"). Recommended.
#        The code default, if unset, is stub.
# stub = NO AUTH — every request is treated as platform-admin. Development only.
#        Refused at startup unless MODUS_ENVIRONMENT=development.
# Set this to stub ONLY for throwaway local development, never for a deployment.
MODUS_AUTH_MODE=jwt
# Required for jwt mode (a long random string, or a PEM public key for RS256):
# MODUS_JWT_SECRET=

# Master key for app registration. Generate:
#   python -c "import secrets; print('mds_master_' + secrets.token_urlsafe(32))"
MODUS_MASTER_API_KEY=mds_master_changeme_to_a_random_string

# ── Network ──────────────────────────────────────────────────────────────────
MODUS_HOST=0.0.0.0
MODUS_PORT=8080
# MODUS_WORKERS=1  # Use container orchestrator replicas instead

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated origins for the dashboard
MODUS_CORS_ORIGINS=http://localhost:8080

# ── Environment ──────────────────────────────────────────────────────────────
# development | staging | production. The code default is 'development'; this
# file sets 'production', which refuses stub auth and the placeholder master key
# and hides the interactive API docs (/docs). Use 'development' only for local
# work, and only together with MODUS_AUTH_MODE=stub.
MODUS_ENVIRONMENT=production

# ── Logging ──────────────────────────────────────────────────────────────────
MODUS_LOG_FORMAT=json
MODUS_LOG_LEVEL=INFO
# MODUS_DEBUG=false

# ── Database Pool (PostgreSQL only) ──────────────────────────────────────────
# MODUS_DB_POOL_SIZE=10
# MODUS_DB_MAX_OVERFLOW=20
# MODUS_DB_POOL_TIMEOUT=30
# MODUS_DB_POOL_RECYCLE=1800

# ── Metrics ──────────────────────────────────────────────────────────────────
# MODUS_METRICS_ENABLED=true
# MODUS_METRICS_PATH=/metrics

# ── Ingest ───────────────────────────────────────────────────────────────────
# MODUS_MAX_BATCH_SIZE=1000
# MODUS_INGEST_DEDUP_TTL_HOURS=48

# ── Aggregation ──────────────────────────────────────────────────────────────
# MODUS_AGGREGATE_INTERVAL_SECONDS=60
# MODUS_HEARTBEAT_STALE_MINUTES=5

# ── Pricing ──────────────────────────────────────────────────────────────────
# MODUS_PRICING_SYNC_INTERVAL_HOURS=24
# MODUS_PRICING_FALLBACK_TO_BUNDLED=true

# ── Enforcement / Policy Engine ──────────────────────────────────────────────
# MODUS_ENFORCEMENT_ENABLED=true
# Gateway and /api/v1/evaluate: allow (true) or deny (false) when evaluation
# times out or errors. SDK clients have their own MODUS_FAIL_OPEN (default true).
# MODUS_ENFORCEMENT_FAIL_OPEN=false
# MODUS_ENFORCEMENT_TIMEOUT_MS=500

# ── Maintenance ──────────────────────────────────────────────────────────────
# MODUS_PRUNE_HEARTBEATS_DAYS=30
# MODUS_PRUNE_BATCHES_HOURS=48

# ── Intelligent Model Routing ───────────────────────────────────
# MODUS_ROUTING_ENABLED=true
# MODUS_ROUTING_CHEAP_MODEL_DEFAULT=claude-haiku-4-5-20251001
# MODUS_ROUTING_DEFAULT_OBSERVE_THRESHOLD=200
# MODUS_ROUTING_CALIBRATOR_INTERVAL_SECONDS=600
# MODUS_ROUTING_DRIFT_MONITOR_INTERVAL_SECONDS=300
# MODUS_ROUTING_SIMILARITY_THRESHOLD=0.85
# MODUS_ROUTING_CONFIDENCE_DECAY_RATE=0.85
# MODUS_ROUTING_MIN_CALIBRATION_SAMPLES=10

# ── AI Summary Engine ────────────────────────────────────────────────────────
# Provider for topology AI summaries.
#
# ⚠️  SECURITY WARNING: External providers (anthropic, openai, google, deepseek)
# send customer infrastructure topology (service names, dependencies, API routes,
# installed packages) to third-party AI services. Only enable if you have explicit
# permission to share this metadata.
#
# Options:
#   - (empty, default): Local text-based summary, NO external calls
#   - ollama: Local Ollama instance, NO external calls
#   - anthropic, openai, google, deepseek: External AI providers (requires API key)
#
# MODUS_SUMMARY_AGENT=                  # default: empty (local text fallback)
# MODUS_SUMMARY_API_KEY=                # required for external providers
# MODUS_SUMMARY_MODEL_ID=               # empty = provider default
# MODUS_SUMMARY_BASE_URL=               # required for Ollama (http://localhost:11434)
#
# Example (local Ollama, recommended):
#   MODUS_SUMMARY_AGENT=ollama
#   MODUS_SUMMARY_BASE_URL=http://localhost:11434
#
# Example (external provider, sends data outside):
#   MODUS_SUMMARY_AGENT=anthropic
#   MODUS_SUMMARY_API_KEY=sk-ant-...

# ── Conductor (Org-Level Aggregation) ────────────────────────────────────────
# URL of the Conductor service for org-wide dashboard aggregation.
#
# ⚠️  SECURITY WARNING: Conductor MUST be customer-hosted on internal infrastructure.
# Public external URLs are REJECTED to prevent aggregated data leakage.
#
# Allowed: localhost, 127.0.0.1, RFC1918 private IPs (10.x, 172.16-31.x, 192.168.x),
#          .internal/.local domains
# Rejected: any public IP or domain resolving to a public IP
#
# Examples (valid):
#   MODUS_CONDUCTOR_URL=http://conductor.internal:8090
#   MODUS_CONDUCTOR_URL=http://192.168.1.100:8090
#   MODUS_CONDUCTOR_URL=http://10.0.0.50:8090
#
# Example (REJECTED):
#   MODUS_CONDUCTOR_URL=https://api.example.com  # ❌ public domain
#
# MODUS_CONDUCTOR_URL=
# MODUS_CONDUCTOR_SECRET=
# MODUS_CONDUCTOR_PUSH_INTERVAL_SECONDS=60
# MODUS_CONDUCTOR_INSTANCE_ID=
# MODUS_CONDUCTOR_INSTANCE_NAME=

# ── Plugins ──────────────────────────────────────────────────────────────────
# MODUS_PLUGINS_ENABLED=true
